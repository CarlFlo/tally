# All entries are optional unless enabling the relevant integration.
# Tally is designed for trusted self-hosted/LAN deployments. Do not expose the
# application port directly to the public internet.
APP_AUTH_MODE=disabled
APP_MAX_PROFILES=8
APP_LANGUAGE=en
APP_THEME_DEFAULT=system
TZ=Europe/Stockholm
# APP_PUBLIC_URL=https://tv.example.com
# Docker host binding. Set 0.0.0.0 (or a specific LAN address) for LAN access.
APP_BIND=127.0.0.1
APP_PORT=8080

LOCAL_PASSWORD_MIN_LENGTH=6
LOCAL_PASSWORD_MAX_LENGTH=128
LOCAL_PASSWORD_RESET_COOLDOWN=60s
SESSION_IDLE_TIMEOUT=30d
SESSION_ABSOLUTE_TIMEOUT=180d

# Scheduling is managed in Settings > Scheduling using the deployment TZ.
# All external calls stay bounded even on manual refresh.
JOB_MAX_CONCURRENCY=4
JOB_MAX_RUNTIME=5m
JOB_MAX_RETRIES=3
JOB_MAX_BATCH_SIZE=50
PROVIDER_MAX_CONCURRENCY=2

STATS_RAW_RETENTION_DAYS=30
STATS_AGGREGATE_RETENTION_DAYS=365

# Configure shared connections and schedules in the web UI:
# Settings > Torrent client: supported client, URL, API key, Test connection.
# Settings > Torrent search: one Jackett base URL and API key.
# Settings > Notifications: Webhook/Discord services, event subscriptions and delivery time.
# Settings > Scheduling: job cron expressions and enable/disable controls.
# These settings are saved in SQLite and included in protected backups.

# APP_AUTH_MODE=oidc
# OIDC_ISSUER_URL=https://identity.example.com/realms/home
# OIDC_CLIENT_ID=tally
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://tv.example.com/auth/oidc/callback
# OIDC_SCOPES=openid,profile,email
# OIDC_AUTO_CREATE_USERS=true

# Manage backup retention and schedules in Settings > Backups.
# Backups always use APP_DATA_DIR/backups; mount a volume there to change host storage.
