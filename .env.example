# Tally is designed for trusted self-hosted/LAN deployments.
# Do not expose directly to the public internet.
APP_MAX_PROFILES=8
APP_THEME_DEFAULT=system
TZ=Europe/Stockholm
# APP_PUBLIC_URL=https://tally.example.com
# Set to 0.0.0.0 or a specific LAN address when LAN access is intended.
APP_BIND=127.0.0.1
APP_PORT=8080
PUID=1000
PGID=1000

LOCAL_PASSWORD_MIN_LENGTH=4
LOCAL_PASSWORD_MAX_LENGTH=128
SESSION_IDLE_TIMEOUT=30d
SESSION_ABSOLUTE_TIMEOUT=180d

JOB_MAX_CONCURRENCY=4
JOB_MAX_RUNTIME=5m
JOB_MAX_RETRIES=3
JOB_MAX_BATCH_SIZE=50
PROVIDER_MAX_CONCURRENCY=2

STATS_RAW_RETENTION_DAYS=30
STATS_AGGREGATE_RETENTION_DAYS=365
